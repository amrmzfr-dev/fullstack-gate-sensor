POSTGRES_DB=gatesensor_prod
POSTGRES_USER=gatesensor
POSTGRES_PASSWORD=change-me

ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=gatesensor_prod;Username=gatesensor;Password=change-me
Redis__ConnectionString=redis:6379
Mqtt__Host=mosquitto
Mqtt__Port=1883
Mqtt__Username=change-me
Mqtt__Password=change-me
Ota__PublicBaseUrl=http://change-me:8090
ASPNETCORE_ENVIRONMENT=Production

# Long random string (e.g. `openssl rand -base64 48`) — signs login JWTs.
Jwt__Key=change-me-to-a-long-random-string

# Accounts to provision on startup (skipped if the username already exists).
# Add/remove indexed pairs as needed; leave unset after first successful boot.
SeedUsers__0__Username=change-me
SeedUsers__0__Password=change-me
